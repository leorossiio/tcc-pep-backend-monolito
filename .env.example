# ===========================================
# Configuração do Ambiente - TCC PEP Backend
# ===========================================
# Copie este arquivo para .env e preencha os valores

# Ambiente
NODE_ENV=development

# Servidor (aplicação NestJS)
PORT=3000

# ===========================================
# PostgreSQL (Dados Estruturados)
# ===========================================
POSTGRES_HOST=postgres-pep
POSTGRES_PORT=5432
POSTGRES_USER=seu_usuario
POSTGRES_PASSWORD=sua_senha
POSTGRES_DB=pep_relacional

# ===========================================
# MongoDB (Dados Semiestruturados/Prontuários)
# ===========================================
MONGO_HOST=mongo-pep
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=seu_usuario
MONGO_INITDB_ROOT_PASSWORD=sua_senha
MONGO_INITDB_DATABASE=pep_nao_relacional

# ===========================================
# Criptografia (LGPD - AES-256-GCM)
# ===========================================
# Gere uma chave segura de 32 bytes em hexadecimal
CRYPTO_SECRET=chave_secreta_32_bytes_hex
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": "Prometheus", "expr": "avg(k6_http_req_duration_p95{arquitetura=\"monolito\",test_scenario=\"mono-ms\"}) * 1000", "legendFormat": "Monolito" },
        { "datasource": "Prometheus", "expr": "avg(k6_http_req_duration_p95{arquitetura=\"ms\",test_scenario=\"mono-ms\"}) * 1000",       "legendFormat": "MS" }
      ]
    },

    { "id": 11, "title": "Latência P99 — Monolito vs MS",
      "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "lineWidth": 2, "fillOpacity": 12 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Monolito" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#4e73df" } }] },

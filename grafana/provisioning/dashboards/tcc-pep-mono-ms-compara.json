        "defaults": { "unit": "percent", "min": 0, "custom": { "lineWidth": 2, "fillOpacity": 15 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Monolito" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#4e73df" } }] },

    { "id": 15, "type": "row",
      "title": "🎯 POST /atendimentos — Ponto Crítico (dual-write Monolito vs simples MS)",
      "description": "Monolito: PG write + MongoDB write (histórico + triagem) + PG log ≈ 3-4 I/Os\nMS: write no atendimento-service (PG) + evento → log-service ≈ 2 I/Os\nEsta é a diferença de arquitetura mais relevante para o TCC.",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 }, "collapsed": false
    },

    { "id": 16, "title": "P95 — POST /atendimentos — Monolito vs MS",
      "description": "Monolito: escreve em PG + MongoDB (histórico + triagem) + PG (log) numa única requisição.\nMS: escreve apenas no atendimento-service (PG) e delega log via evento.\nEspera-se que o monolito seja mais lento aqui devido ao overhead do dual-write.",
      "type": "timeseries", "gridPos": { "h": 9, "w": 16, "x": 0, "y": 28 },
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "lineWidth": 3, "fillOpacity": 20 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Monolito (dual-write PG+Mongo)" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#4e73df" } }] },
          { "matcher": { "id": "byName", "options": "MS (apenas PG)" },                 "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#f6a623" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": "Prometheus", "expr": "k6_http_req_duration_p95{name=\"POST /atendimentos\",arquitetura=\"monolito\",test_scenario=\"mono-ms\"} * 1000", "legendFormat": "Monolito (dual-write PG+Mongo)" },
        { "datasource": "Prometheus", "expr": "k6_http_req_duration_p95{name=\"POST /atendimentos\",arquitetura=\"ms\",test_scenario=\"mono-ms\"} * 1000",       "legendFormat": "MS (apenas PG)" }
      ]
    },

    { "id": 17, "title": "Média Latência — POST /atendimentos",
      "type": "bargauge", "gridPos": { "h": 9, "w": 8, "x": 16, "y": 28 },
      "options": { "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] }, "displayMode": "gradient", "showUnfilled": true },
      "fieldConfig": { "defaults": { "unit": "ms", "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 300 }, { "color": "orange", "value": 600 }, { "color": "red", "value": 1000 }] } } },
      "targets": [
        { "datasource": "Prometheus", "expr": "k6_http_req_duration_avg{name=\"POST /atendimentos\",arquitetura=\"monolito\",test_scenario=\"mono-ms\"} * 1000", "legendFormat": "Monolito (dual-write)" },
        { "datasource": "Prometheus", "expr": "k6_http_req_duration_avg{name=\"POST /atendimentos\",arquitetura=\"ms\",test_scenario=\"mono-ms\"} * 1000",       "legendFormat": "MS (simples)" }
      ]
    },


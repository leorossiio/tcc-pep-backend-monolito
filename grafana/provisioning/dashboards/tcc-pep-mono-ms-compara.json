    { "id": 13, "title": "Throughput (req/s) — Monolito vs MS",
      "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 15 } },

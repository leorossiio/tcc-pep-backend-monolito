{
  "title": "TCC PEP — Monolito vs Microsserviços (CRUD Stress)",
  "uid": "tcc-pep-mono-ms",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "timezone": "browser",
  "tags": ["tcc", "pep", "k6", "benchmarking", "monolito", "ms"],
  "panels": [

    { "id": 1, "type": "row", "title": "▶ Visão Geral — Monolito vs MS", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false },

    { "id": 2, "title": "VUs Ativos (total)", "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "options": { "graphMode": "area", "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 350 }] } } },
      "targets": [{ "datasource": "Prometheus", "expr": "sum(k6_vus{test_scenario=\"mono-ms\"})", "legendFormat": "VUs" }]
    },

    { "id": 3, "title": "Throughput — Monolito", "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 1 },
      "options": { "graphMode": "area", "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "fixed", "fixedColor": "#4e73df" } } },
      "targets": [{ "datasource": "Prometheus", "expr": "sum(rate(k6_http_reqs_total{arquitetura=\"monolito\",test_scenario=\"mono-ms\"}[30s]))", "legendFormat": "Monolito req/s" }]
    },

    { "id": 4, "title": "Throughput — MS", "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 1 },
      "options": { "graphMode": "area", "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "fixed", "fixedColor": "#f6a623" } } },
      "targets": [{ "datasource": "Prometheus", "expr": "sum(rate(k6_http_reqs_total{arquitetura=\"ms\",test_scenario=\"mono-ms\"}[30s]))", "legendFormat": "MS req/s" }]
    },

    { "id": 5, "title": "P95 Latência — Monolito", "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 1 },
      "options": { "graphMode": "area", "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "ms", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 500 }, { "color": "red", "value": 1000 }] } } },
      "targets": [{ "datasource": "Prometheus", "expr": "avg(k6_http_req_duration_p95{arquitetura=\"monolito\",test_scenario=\"mono-ms\"}) * 1000", "legendFormat": "P95" }]
    },

    { "id": 6, "title": "P95 Latência — MS", "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 1 },
      "options": { "graphMode": "area", "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "ms", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 500 }, { "color": "red", "value": 1000 }] } } },
      "targets": [{ "datasource": "Prometheus", "expr": "avg(k6_http_req_duration_p95{arquitetura=\"ms\",test_scenario=\"mono-ms\"}) * 1000", "legendFormat": "P95" }]
    },

    { "id": 7, "title": "Taxa de Erros — Monolito (%)", "type": "stat",
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 5 },
      "options": { "graphMode": "none", "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] } } },
      "targets": [{ "datasource": "Prometheus", "expr": "(avg(k6_http_req_failed_rate{arquitetura=\"monolito\",test_scenario=\"mono-ms\"}) or vector(0)) * 100", "legendFormat": "% Erros" }]
    },

    { "id": 8, "title": "Taxa de Erros — MS (%)", "type": "stat",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 5 },
      "options": { "graphMode": "none", "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] } } },
      "targets": [{ "datasource": "Prometheus", "expr": "(avg(k6_http_req_failed_rate{arquitetura=\"ms\",test_scenario=\"mono-ms\"}) or vector(0)) * 100", "legendFormat": "% Erros" }]
    },

    { "id": 9, "type": "row", "title": "▶ Latência Comparada (P95 e P99)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }, "collapsed": false },


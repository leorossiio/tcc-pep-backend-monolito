{
  "title": "TCC PEP — Monolito (Cenário Comparativo)",
  "uid": "tcc-pep-monolito",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "5s",
  "time": {"from": "now-30m", "to": "now"},
  "timezone": "browser",
  "tags": ["tcc", "pep", "k6", "monolito", "poliglota"],
  "templating": {
    "list": [
      {
        "current": {"selected": false, "text": "normal", "value": "normal"},
        "hide": 0,
        "includeAll": false,
        "label": "Cenário",
        "name": "scenario",
        "options": [
          {"selected": true,  "text": "normal",      "value": "normal"},
          {"selected": false, "text": "dia-corrido",  "value": "dia-corrido"},
          {"selected": false, "text": "emergencia",   "value": "emergencia"}
        ],
        "query": "normal,dia-corrido,emergencia",
        "type": "custom"
      }
    ]
  },
  "panels": [
    {"id":1,"type":"row","title":"k6 — Visão Geral da Carga (Monolito · $scenario)","gridPos":{"h":1,"w":24,"x":0,"y":0},"collapsed":false},
    {"id":2,"title":"VUs Ativos","type":"stat","gridPos":{"h":4,"w":4,"x":0,"y":1},"options":{"graphMode":"area","colorMode":"background","reduceOptions":{"calcs":["lastNotNull"]}},"fieldConfig":{"defaults":{"unit":"short","thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"yellow","value":80},{"color":"red","value":200}]}}},"targets":[{"datasource":"Prometheus","expr":"k6_vus{test_scenario=\"$scenario\",system_type=\"monolito\"}","legendFormat":"VUs"}]},
    {"id":3,"title":"Throughput (req/s)","type":"stat","gridPos":{"h":4,"w":4,"x":4,"y":1},"options":{"graphMode":"area","colorMode":"background","reduceOptions":{"calcs":["lastNotNull"]}},"fieldConfig":{"defaults":{"unit":"reqps","color":{"mode":"fixed","fixedColor":"blue"}}},"targets":[{"datasource":"Prometheus","expr":"sum(rate(k6_http_reqs_total{test_scenario=\"$scenario\",system_type=\"monolito\"}[30s]))","legendFormat":"req/s"}]},
    {"id":4,"title":"Taxa de Erros (%)","type":"stat","gridPos":{"h":4,"w":4,"x":8,"y":1},"options":{"graphMode":"none","colorMode":"background","reduceOptions":{"calcs":["lastNotNull"]}},"fieldConfig":{"defaults":{"unit":"percent","thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"yellow","value":0.5},{"color":"red","value":1}]}}},"targets":[{"datasource":"Prometheus","expr":"(avg(k6_http_req_failed_rate{test_scenario=\"$scenario\",system_type=\"monolito\"}) or vector(0)) * 100","legendFormat":"% erros"}]},
    {"id":5,"title":"p99 Latência Geral (k6)","type":"stat","gridPos":{"h":4,"w":4,"x":12,"y":1},"options":{"graphMode":"area","colorMode":"background","reduceOptions":{"calcs":["lastNotNull"]}},"fieldConfig":{"defaults":{"unit":"ms","thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"yellow","value":400},{"color":"red","value":800}]}}},"targets":[{"datasource":"Prometheus","expr":"avg(k6_http_req_duration_p99{test_scenario=\"$scenario\",system_type=\"monolito\"}) * 1000","legendFormat":"p99 ms"}]},
    {"id":6,"title":"Checks k6 — % Passando agora","type":"stat","gridPos":{"h":4,"w":8,"x":16,"y":1},"options":{"graphMode":"none","colorMode":"background","reduceOptions":{"calcs":["lastNotNull"]},"orientation":"horizontal"},"fieldConfig":{"defaults":{"unit":"percentunit","thresholds":{"mode":"absolute","steps":[{"color":"red","value":null},{"color":"yellow","value":0.95},{"color":"green","value":1}]},"color":{"mode":"thresholds"}}},"targets":[{"datasource":"Prometheus","expr":"k6_checks_rate{test_scenario=\"$scenario\",system_type=\"monolito\"}","legendFormat":"{{check}}"}]},
    {"id":7,"title":"VUs ao Longo do Tempo","type":"timeseries","gridPos":{"h":6,"w":12,"x":0,"y":5},"fieldConfig":{"defaults":{"unit":"short","color":{"mode":"fixed","fixedColor":"blue"},"custom":{"drawStyle":"bars","fillOpacity":60,"lineWidth":0}}},"options":{"legend":{"displayMode":"list","placement":"bottom"}},"targets":[{"datasource":"Prometheus","expr":"k6_vus{test_scenario=\"$scenario\",system_type=\"monolito\"}","legendFormat":"VUs"}]},
    {"id":8,"title":"Throughput ao Longo do Tempo (req/s)","type":"timeseries","gridPos":{"h":6,"w":12,"x":12,"y":5},"fieldConfig":{"defaults":{"unit":"reqps","color":{"mode":"palette-classic"}}},"options":{"legend":{"displayMode":"list","placement":"bottom"}},"targets":[{"datasource":"Prometheus","expr":"sum(rate(k6_http_reqs_total{test_scenario=\"$scenario\",system_type=\"monolito\"}[30s]))","legendFormat":"req/s total"}]},

    {"id":9,"type":"row","title":"Monolito — Gargalos e Comunicação","gridPos":{"h":1,"w":24,"x":0,"y":11},"collapsed":false},
    {"id":10,"title":"Monolito (POST /atendimentos) · Gatilho HTTP","description":"Dual-write: PostgreSQL (atendimento) + MongoDB (historico + consulta_laudo). Custo real da persistência poliglota. Percentis do histograma nativo do NestJS.","type":"timeseries","gridPos":{"h":8,"w":12,"x":0,"y":12},"fieldConfig":{"defaults":{"unit":"ms","color":{"mode":"palette-classic"}},"overrides":[{"matcher":{"id":"byName","options":"p95"},"properties":[{"id":"custom.lineWidth","value":3}]}]},"options":{"legend":{"displayMode":"list","placement":"bottom"},"tooltip":{"mode":"multi"}},"targets":[{"datasource":"Prometheus","expr":"histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{method=\"POST\",path=\"/atendimentos\"}[30s])) by (le)) * 1000","legendFormat":"p50"},{"datasource":"Prometheus","expr":"histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{method=\"POST\",path=\"/atendimentos\"}[30s])) by (le)) * 1000","legendFormat":"p95"},{"datasource":"Prometheus","expr":"histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{method=\"POST\",path=\"/atendimentos\"}[30s])) by (le)) * 1000","legendFormat":"p99"}]},
    {"id":11,"title":"Monolito (POST /medicos) · Carga Base","description":"Escrita simples em PostgreSQL, sem overhead poliglota. Linha de base para isolar o custo do dual-write.","type":"timeseries","gridPos":{"h":8,"w":12,"x":12,"y":12},"fieldConfig":{"defaults":{"unit":"ms","color":{"mode":"palette-classic"}},"overrides":[{"matcher":{"id":"byName","options":"p95"},"properties":[{"id":"custom.lineWidth","value":3}]}]},"options":{"legend":{"displayMode":"list","placement":"bottom"},"tooltip":{"mode":"multi"}},"targets":[{"datasource":"Prometheus","expr":"histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{method=\"POST\",path=\"/medicos\"}[30s])) by (le)) * 1000","legendFormat":"p50"},{"datasource":"Prometheus","expr":"histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{method=\"POST\",path=\"/medicos\"}[30s])) by (le)) * 1000","legendFormat":"p95"},{"datasource":"Prometheus","expr":"histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{method=\"POST\",path=\"/medicos\"}[30s])) by (le)) * 1000","legendFormat":"p99"}]},
    {"id":12,"title":"p95 atual — Monolito Atendimentos","type":"stat","gridPos":{"h":4,"w":6,"x":0,"y":20},"options":{"graphMode":"none","colorMode":"background","reduceOptions":{"calcs":["lastNotNull"]}},"fieldConfig":{"defaults":{"unit":"ms","thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"yellow","value":500},{"color":"red","value":800}]}}},"targets":[{"datasource":"Prometheus","expr":"histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{method=\"POST\",path=\"/atendimentos\"}[1m])) by (le)) * 1000","legendFormat":"p95 Atendimentos"}]},
    {"id":13,"title":"p95 atual — Monolito Médicos","type":"stat","gridPos":{"h":4,"w":6,"x":6,"y":20},"options":{"graphMode":"none","colorMode":"background","reduceOptions":{"calcs":["lastNotNull"]}},"fieldConfig":{"defaults":{"unit":"ms","thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"yellow","value":200},{"color":"red","value":500}]}}},"targets":[{"datasource":"Prometheus","expr":"histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{method=\"POST\",path=\"/medicos\"}[1m])) by (le)) * 1000","legendFormat":"p95 Médicos"}]},
    {"id":14,"title":"Comparativo p95 — Atendimentos vs Médicos","description":"Diferença entre escrita poliglota (PG+Mongo) e escrita simples (só PG). Quanto maior a diferença, maior o custo da persistência poliglota.","type":"bargauge","gridPos":{"h":4,"w":12,"x":12,"y":20},"options":{"orientation":"horizontal","reduceOptions":{"calcs":["lastNotNull"]},"displayMode":"gradient","showUnfilled":true},"fieldConfig":{"defaults":{"unit":"ms","min":0,"max":1000,"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"yellow","value":400},{"color":"red","value":800}]}}},"targets":[{"datasource":"Prometheus","expr":"histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{method=\"POST\",path=\"/atendimentos\"}[1m])) by (le)) * 1000","legendFormat":"Atendimentos "},{"datasource":"Prometheus","expr":"histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{method=\"POST\",path=\"/medicos\"}[1m])) by (le)) * 1000","legendFormat":"Médicos — Escrita simples (só PG)"}]},

    {"id":15,"type":"row","title":"Demais Endpoints — Latência (histograma nativo NestJS)","gridPos":{"h":1,"w":24,"x":0,"y":24},"collapsed":false},
    {"id":16,"title":"GET /atendimentos/:id · Leitura Poliglota (PG → Mongo)","type":"timeseries","gridPos":{"h":7,"w":8,"x":0,"y":25},"fieldConfig":{"defaults":{"unit":"ms","color":{"mode":"palette-classic"}}},"options":{"legend":{"displayMode":"list","placement":"bottom"},"tooltip":{"mode":"multi"}},"targets":[{"datasource":"Prometheus","expr":"histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{method=\"GET\",path=\"/atendimentos/:id\"}[30s])) by (le)) * 1000","legendFormat":"p50"},{"datasource":"Prometheus","expr":"histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{method=\"GET\",path=\"/atendimentos/:id\"}[30s])) by (le)) * 1000","legendFormat":"p95"},{"datasource":"Prometheus","expr":"histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{method=\"GET\",path=\"/atendimentos/:id\"}[30s])) by (le)) * 1000","legendFormat":"p99"}]},
    {"id":17,"title":"GET /pacientes/:id","type":"timeseries","gridPos":{"h":7,"w":8,"x":8,"y":25},"fieldConfig":{"defaults":{"unit":"ms","color":{"mode":"palette-classic"}}},"options":{"legend":{"displayMode":"list","placement":"bottom"},"tooltip":{"mode":"multi"}},"targets":[{"datasource":"Prometheus","expr":"histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{method=\"GET\",path=\"/pacientes/:id\"}[30s])) by (le)) * 1000","legendFormat":"p50"},{"datasource":"Prometheus","expr":"histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{method=\"GET\",path=\"/pacientes/:id\"}[30s])) by (le)) * 1000","legendFormat":"p95"},{"datasource":"Prometheus","expr":"histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{method=\"GET\",path=\"/pacientes/:id\"}[30s])) by (le)) * 1000","legendFormat":"p99"}]},
    {"id":18,"title":"GET /medicos/:id/atendimentos · triagens do médico","type":"timeseries","gridPos":{"h":7,"w":8,"x":16,"y":25},"fieldConfig":{"defaults":{"unit":"ms","color":{"mode":"palette-classic"}}},"options":{"legend":{"displayMode":"list","placement":"bottom"},"tooltip":{"mode":"multi"}},"targets":[{"datasource":"Prometheus","expr":"histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{method=\"GET\",path=\"/medicos/:id/atendimentos\"}[30s])) by (le)) * 1000","legendFormat":"p50"},{"datasource":"Prometheus","expr":"histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{method=\"GET\",path=\"/medicos/:id/atendimentos\"}[30s])) by (le)) * 1000","legendFormat":"p95"},{"datasource":"Prometheus","expr":"histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{method=\"GET\",path=\"/medicos/:id/atendimentos\"}[30s])) by (le)) * 1000","legendFormat":"p99"}]},
    {"id":19,"title":"GET /pacientes/:id/historico-completo · triagens do paciente (visão 360°)","type":"timeseries","gridPos":{"h":7,"w":24,"x":0,"y":32},"fieldConfig":{"defaults":{"unit":"ms","color":{"mode":"palette-classic"}}},"options":{"legend":{"displayMode":"list","placement":"bottom"},"tooltip":{"mode":"multi"}},"targets":[{"datasource":"Prometheus","expr":"histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{method=\"GET\",path=\"/pacientes/:id/historico-completo\"}[30s])) by (le)) * 1000","legendFormat":"p50"},{"datasource":"Prometheus","expr":"histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{method=\"GET\",path=\"/pacientes/:id/historico-completo\"}[30s])) by (le)) * 1000","legendFormat":"p95"},{"datasource":"Prometheus","expr":"histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{method=\"GET\",path=\"/pacientes/:id/historico-completo\"}[30s])) by (le)) * 1000","legendFormat":"p99"}]},

    {"id":20,"type":"row","title":"Checks k6 — Critérios de Aceitação do TCC","gridPos":{"h":1,"w":24,"x":0,"y":39},"collapsed":false},
    {"id":21,"title":"% Checks passando por critério","description":"1 = 100% passando. Queda indica violação do SLA.","type":"timeseries","gridPos":{"h":8,"w":24,"x":0,"y":40},"fieldConfig":{"defaults":{"unit":"percentunit","min":0,"max":1,"color":{"mode":"palette-classic"},"custom":{"lineWidth":2,"fillOpacity":15}}},"options":{"legend":{"displayMode":"table","placement":"right","calcs":["mean","lastNotNull"]},"tooltip":{"mode":"multi"}},"targets":[{"datasource":"Prometheus","expr":"k6_checks_rate{test_scenario=\"$scenario\",system_type=\"monolito\"}","legendFormat":"{{check}}"}]},

    {"id":22,"type":"row","title":"Node.js — Runtime sob Carga","gridPos":{"h":1,"w":24,"x":0,"y":48},"collapsed":false},
    {"id":23,"title":"Heap Node.js (MB)","type":"timeseries","gridPos":{"h":7,"w":8,"x":0,"y":49},"fieldConfig":{"defaults":{"unit":"decmbytes","color":{"mode":"palette-classic"}},"overrides":[{"matcher":{"id":"byName","options":"heap total"},"properties":[{"id":"custom.lineStyle","value":{"dash":[8,4],"fill":"dash"}}]}]},"options":{"legend":{"displayMode":"list","placement":"bottom"}},"targets":[{"datasource":"Prometheus","expr":"nodejs_heap_size_used_bytes / 1024 / 1024","legendFormat":"heap usada"},{"datasource":"Prometheus","expr":"nodejs_heap_size_total_bytes / 1024 / 1024","legendFormat":"heap total"}]},
    {"id":24,"title":"Event Loop Lag (ms)","description":"Valores altos indicam saturação de I/O nos dois bancos.","type":"timeseries","gridPos":{"h":7,"w":8,"x":8,"y":49},"fieldConfig":{"defaults":{"unit":"ms","color":{"mode":"thresholds"},"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"yellow","value":50},{"color":"red","value":200}]},"custom":{"fillOpacity":20}}},"options":{"legend":{"displayMode":"list","placement":"bottom"}},"targets":[{"datasource":"Prometheus","expr":"nodejs_eventloop_lag_seconds * 1000","legendFormat":"event loop lag"}]},
    {"id":25,"title":"Latência p95 por Endpoint (ms)","description":"p95 do histograma nativo agrupado por rota.","type":"timeseries","gridPos":{"h":7,"w":8,"x":16,"y":49},"fieldConfig":{"defaults":{"unit":"ms","color":{"mode":"palette-classic"},"custom":{"lineWidth":2,"fillOpacity":10}}},"options":{"legend":{"displayMode":"table","placement":"right","calcs":["lastNotNull","max"]},"tooltip":{"mode":"multi"}},"targets":[{"datasource":"Prometheus","expr":"histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le, method, path)) * 1000","legendFormat":"{{method}} {{path}}"}]}
  ]
}
